# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# Application
APP_NAME=Production AI Agent
APP_VERSION=1.0.0

# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Security
